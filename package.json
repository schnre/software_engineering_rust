{
  "name": "rust-engineering-academy",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Lern-Web-App: Software-Engineering-Wissen für Rust- und Embedded-Entwickler in kurzen, spielerischen Lektionen.",
  "scripts": {
    "dev": "vite",
    "validate": "node scripts/validate-content.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "npm run validate && tsc --noEmit && vite build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "ajv": "^8.17.1",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0"
  }
}
